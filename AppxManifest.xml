<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="DhruvGupta.GeoFluentGeometryCalculator"
            Publisher="CN=DhruvGupta"
            Version="1.2.0.0"
            ProcessorArchitecture="x64" />
  
  <Properties>
    <DisplayName>GeoFluent Geometry Calculator</DisplayName>
    <PublisherDisplayName>Dhruv Gupta</PublisherDisplayName>
    <Logo>assets\store\StoreLogo.png</Logo>
    <Description>High-precision Windows 11 Fluent 2 Geometry Calculator with interactive 2D diagrams, 3D WebGL solids, multi-method calculation, unit conversions, and step-by-step mathematical derivations.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="GeoFluent"
                 Executable="GeoFluent.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="GeoFluent Geometry Calculator"
                          Description="Geometry app for Windows 11"
                          BackgroundColor="#18191C"
                          Square150x150Logo="assets\store\Square150x150Logo.png"
                          Square44x44Logo="assets\store\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\store\Wide310x150Logo.png"
                         Square310x310Logo="assets\store\Square310x310Logo.png"
                         ShortName="GeoFluent">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="assets\icon.png" BackgroundColor="#18191C" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
