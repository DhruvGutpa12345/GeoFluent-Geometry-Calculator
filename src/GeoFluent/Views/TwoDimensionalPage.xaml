<Page
    x:Class="GeoFluent.Views.TwoDimensionalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:math="using:GeoFluent.Math"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="2D Plane Shapes" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Calculate areas, perimeters, internal angles, radii, and step-by-step mathematical derivations." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Shape Selector Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Select Shape:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbShape" SelectedIndex="0" SelectionChanged="CmbShape_SelectionChanged" Width="220">
                        <ComboBoxItem Content="Triangle (3 Sides)" Tag="Triangle" />
                        <ComboBoxItem Content="Rectangle" Tag="Rectangle" />
                        <ComboBoxItem Content="Square" Tag="Square" />
                        <ComboBoxItem Content="Circle" Tag="Circle" />
                        <ComboBoxItem Content="Parallelogram" Tag="Parallelogram" />
                        <ComboBoxItem Content="Rhombus" Tag="Rhombus" />
                        <ComboBoxItem Content="Trapezoid" Tag="Trapezoid" />
                        <ComboBoxItem Content="Regular Polygon" Tag="Polygon" />
                        <ComboBoxItem Content="Ellipse" Tag="Ellipse" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Parameters Input & Interactive Preview Grid -->
            <Grid ColumnDefinitions="*,360" ColumnSpacing="20">
                <!-- Input Parameters Card -->
                <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Input Parameters" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        
                        <StackPanel x:Name="InputsPanel" Spacing="12" />

                        <Button x:Name="BtnCalculate" Content="Calculate" Style="{ThemeResource AccentButtonStyle}" Click="BtnCalculate_Click" Width="140" HorizontalAlignment="Left" />
                        
                        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Calculation Error" Message="" />
                    </StackPanel>
                </Border>

                <!-- 2D Geometry Visualizer Canvas -->
                <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" Height="260">
                    <Grid>
                        <TextBlock Text="Shape Geometry Canvas" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <Canvas x:Name="GeometryCanvas" Width="280" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Results Card -->
            <Border x:Name="ResultsCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Calculation Outputs" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ItemsControl x:Name="OutputsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="math:CalculationOutput">
                                <Grid Margin="0,4" ColumnDefinitions="200,*,Auto">
                                    <TextBlock Text="{x:Bind Label}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="6,2">
                                        <TextBlock Text="{x:Bind Symbol}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Mathematical Steps Card -->
            <Border x:Name="StepsCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Step-by-Step Derivation" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="math:CalculationStep">
                                <StackPanel Margin="0,8" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind Formula}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Consolas, Cascadia Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Substitution}" Style="{ThemeResource BodyTextBlockStyle}" FontFamily="Consolas, Cascadia Code" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
