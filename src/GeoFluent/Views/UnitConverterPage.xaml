<Page
    x:Class="GeoFluent.Views.UnitConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Left">
            
            <StackPanel Spacing="4">
                <TextBlock Text="Unit Converter" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="High-precision conversion across Metric and Imperial length, area, volume, and angle units." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Unit Type Selector -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Unit Category:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbCategory" SelectedIndex="0" SelectionChanged="CmbCategory_SelectionChanged" Width="200">
                        <ComboBoxItem Content="Length" Tag="Length" />
                        <ComboBoxItem Content="Area" Tag="Area" />
                        <ComboBoxItem Content="Volume" Tag="Volume" />
                        <ComboBoxItem Content="Angle" Tag="Angle" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Conversion Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Convert Values" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                        <!-- From Section -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="From:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CmbFromUnit" HorizontalAlignment="Stretch" SelectionChanged="CmbFromUnit_SelectionChanged" />
                            <TextBox x:Name="TxtFromValue" Text="1" TextChanged="TxtFromValue_TextChanged" />
                        </StackPanel>

                        <!-- Swap Button -->
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" Click="BtnSwap_Click">
                            <FontIcon Glyph="&#xE8AB;" />
                        </Button>

                        <!-- To Section -->
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="To:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CmbToUnit" HorizontalAlignment="Stretch" SelectionChanged="CmbToUnit_SelectionChanged" />
                            <TextBox x:Name="TxtToValue" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtConversionFormula" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
