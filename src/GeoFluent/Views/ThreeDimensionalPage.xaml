<Page
    x:Class="GeoFluent.Views.ThreeDimensionalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1020" HorizontalAlignment="Left">
            
            <!-- Page Header with Action Buttons -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TxtHeaderTitle" Text="3D Solid Shapes" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Name="TxtHeaderDesc" Text="Calculate volume, total surface area, lateral areas, space diagonals, and derivations." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyReport" Click="BtnCopyReport_Click" ToolTipService.ToolTip="Copy full formatted calculation report to clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" />
                            <TextBlock Text="Copy Report" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSaveHistory" Click="BtnSaveHistory_Click" ToolTipService.ToolTip="Save this calculation to history">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Shape Search & Selector Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <Grid ColumnDefinitions="*,Auto,260" ColumnSpacing="16">
                    <TextBox x:Name="TxtSearchShape" PlaceholderText="Search 3D solids (e.g. Sphere, Cone, Torus, Dodecahedron)..." TextChanged="TxtSearchShape_TextChanged" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="Select Solid:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />

                    <ComboBox Grid.Column="2" x:Name="CmbShape" HorizontalAlignment="Stretch" SelectionChanged="CmbShape_SelectionChanged" />
                </Grid>
            </Border>

            <!-- Method Selector Card -->
            <Border x:Name="MethodCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <TextBlock Text="Calculation Method:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="CmbMethod" HorizontalAlignment="Stretch" SelectionChanged="CmbMethod_SelectionChanged" />
                    <TextBlock Grid.Column="2" x:Name="TxtMethodDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Work Area: Parameters & Interactive 3D Visualizer -->
            <Grid ColumnDefinitions="*,400" ColumnSpacing="20">
                <!-- Input Dimensions Card -->
                <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Input Dimensions" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Dynamic Input Rows with Per-Input Units -->
                        <StackPanel x:Name="InputsPanel" Spacing="12" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnCalculate" Content="Recalculate" Style="{ThemeResource AccentButtonStyle}" Click="BtnCalculate_Click" Width="130" />
                            <CheckBox x:Name="ChkAutoCalc" Content="Auto-calculate on change" IsChecked="True" VerticalAlignment="Center" />
                        </StackPanel>

                        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Calculation Error" Message="" />
                        <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Success" Title="Success" Message="" />
                    </StackPanel>
                </Border>

                <!-- Interactive 3D Solid Visualizer -->
                <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                            <TextBlock Text="3D Solid Isometric Visualizer" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" x:Name="ChkAutoRotate" Content="Auto-Rotate" IsChecked="True" Checked="ChkAutoRotate_Toggled" Unchecked="ChkAutoRotate_Toggled" />
                        </Grid>

                        <!-- Canvas Host with Clip to bounds -->
                        <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorTransparentBrush}" Height="230" CornerRadius="4">
                            <Canvas x:Name="Geometry3DCanvas" Width="360" Height="230" />
                        </Border>

                        <!-- Rotation Controls -->
                        <StackPanel Grid.Row="2" Spacing="4" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="40,*">
                                <TextBlock Text="Yaw" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SliderYaw" Minimum="0" Maximum="360" Value="35" ValueChanged="SliderRotation_ValueChanged" Margin="8,0,0,0" />
                            </Grid>
                            <Grid ColumnDefinitions="40,*">
                                <TextBlock Text="Pitch" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" x:Name="SliderPitch" Minimum="-90" Maximum="90" Value="25" ValueChanged="SliderRotation_ValueChanged" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Results Card with Unit Customization -->
            <Border x:Name="ResultsCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Calculated Solid Properties" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        
                        <!-- Output Units Customizer -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Display Units:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbOutputVolumeUnit" Width="120" SelectionChanged="CmbOutputUnit_SelectionChanged" />
                            <ComboBox x:Name="CmbOutputAreaUnit" Width="100" SelectionChanged="CmbOutputUnit_SelectionChanged" />
                            <ComboBox x:Name="CmbOutputLengthUnit" Width="100" SelectionChanged="CmbOutputUnit_SelectionChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="OutputsPanel" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Step-by-Step Mathematical Derivation Card -->
            <Border x:Name="StepsCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock Text="Step-by-Step Solid Derivations &amp; Formulas" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="StepsPanel" Spacing="12" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
