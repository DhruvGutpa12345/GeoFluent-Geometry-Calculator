<Page
    x:Class="GeoFluent.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:GeoFluent.Services"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1020" HorizontalAlignment="Left">
            
            <!-- Page Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Calculation History" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Review, reload, and export previous geometry computations and derivation steps." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnExport" Click="BtnExport_Click" ToolTipService.ToolTip="Export all calculation history to Markdown">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" />
                            <TextBlock Text="Export Markdown" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClear" Click="BtnClear_Click" ToolTipService.ToolTip="Clear all saved calculations">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock Text="Clear All" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Success" Title="History" Message="" />

            <!-- Empty State -->
            <Border x:Name="EmptyCard" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="32" HorizontalAlignment="Stretch" Visibility="Collapsed">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No calculations saved yet." Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Perform calculations in 2D or 3D modules and click 'Save' to keep records here." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Interactive History Cards Stack -->
            <ItemsControl x:Name="HistoryItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:FullHistoryEntry">
                        <Border Margin="0,0,0,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                
                                <!-- Card Header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Category}" Foreground="White" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ShapeName}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind MethodName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Timestamp}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Actions: Restore & Delete -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="Restore ↗" Click="BtnRestore_Click" Tag="{x:Bind Id}" Style="{ThemeResource AccentButtonStyle}" Padding="10,4" />
                                        <Button Click="BtnDelete_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="Delete this record" Padding="6,4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Inputs Row -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind Inputs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:SavedInputRecord">
                                                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,4">
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                                        <Run Text="{x:Bind Label}" FontWeight="SemiBold"/>: <Run Text="{x:Bind Value}"/> <Run Text="{x:Bind UnitSymbol}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Outputs Row -->
                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind Outputs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:SavedOutputRecord">
                                                <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorTertiaryBrush}" Padding="8,4">
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                                        <Run Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>: <Run Text="{x:Bind ValueWithUnit}" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
