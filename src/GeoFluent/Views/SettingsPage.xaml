<Page
    x:Class="GeoFluent.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="1020" HorizontalAlignment="Left">
            
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; About" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Configure appearance themes, calculation precision, default units, and review architecture metadata." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Appearance & Theme Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance &amp; Theme" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Select whether to match Windows 11 system theme or enforce Dark or Light Fluent mode." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <RadioButtons x:Name="ThemeRadioGroup" SelectionChanged="ThemeRadioGroup_SelectionChanged" Margin="0,4,0,0">
                        <RadioButton Content="System Default" Tag="Default" />
                        <RadioButton Content="Dark Mode (Mica Dark)" Tag="Dark" />
                        <RadioButton Content="Light Mode (Mica Light)" Tag="Light" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Precision & Defaults Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Calculation Precision &amp; Defaults" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Decimal Places Precision:" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbPrecision" SelectionChanged="CmbPrecision_SelectionChanged" Width="140">
                            <ComboBoxItem Content="2 Decimals" Tag="2" />
                            <ComboBoxItem Content="3 Decimals" Tag="3" />
                            <ComboBoxItem Content="4 Decimals" Tag="4" />
                            <ComboBoxItem Content="6 Decimals" Tag="6" />
                            <ComboBoxItem Content="8 Decimals" Tag="8" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Default System Units:" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Metric (cm, cm², cm³) with optional Imperial toggles on every field" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- App Architecture & Store Identity Card -->
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="GeoFluent - Geometry Calculator" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="High-Precision Native Windows 11 Fluent 2 Architecture" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="24">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Live Build Version" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtAppVersion" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Runtime Target" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text=".NET 10 LTS (net10.0-windows10.0.26100.0)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="UI Engine" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="WinUI 3 (Windows App SDK 2.5.1)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Zero-Bloat Mandate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="100% Native Compiled UI (Zero Electron, Zero WebView2)" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Store Package Identity" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="DhruvGupta.GeoFluent-GeometryCalculator" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Publisher ID" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="CN=CB32F928-2859-4967-B8F7-396A9964D1FB" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="License" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="MIT Open-Source License" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock Text="Store Asset Matrix" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Custom VectorCraft branding on all device tile sizes" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
