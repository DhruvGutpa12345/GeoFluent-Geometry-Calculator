{
  "name": "geofluent-geometry-calculator",
  "productName": "GeoFluent",
  "version": "1.3.0",
  "description": "High-precision Fluent 2 Geometry Calculator for Windows 11 with interactive 2D diagrams, 3D WebGL solids, and unit conversions.",
  "main": "src/main/main.js",
  "author": "Dhruv Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DhruvGutpa12345/GeoFluent-Geometry-Calculator.git"
  },
  "scripts": {
    "clean:dist": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')){fs.readdirSync('dist').forEach(f=>{if(!f.endsWith('.md') && f!=='win-unpacked'){try{fs.rmSync('dist/'+f,{recursive:true,force:true})}catch(e){}}})}\"",
    "bundle": "esbuild src/renderer/js/app.js --bundle --minify --outfile=src/renderer/js/bundle.js --format=iife --platform=browser",
    "start": "npm run bundle && electron .",
    "build": "npm run bundle && electron-builder --win",
    "pack:exe": "npm run bundle && electron-builder --win nsis portable",
    "pack:msi": "npm run bundle && electron-builder --win msi",
    "pack:appx": "npm run bundle && electron-builder --win appx"
  },
  "build": {
    "appId": "com.dhruvgupta.geofluent",
    "productName": "GeoFluent",
    "compression": "maximum",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/styles/**/*",
      "src/renderer/js/bundle.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "signtoolOptions": {
        "certificateFile": "certs/GeoFluentDev.pfx",
        "certificatePassword": "GeoFluent2026"
      },
      "target": [
        "nsis",
        "portable",
        "msi",
        "appx"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeoFluent Geometry Calculator",
      "artifactName": "GeoFluent-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GeoFluent-Portable-${version}.${ext}"
    },
    "msi": {
      "artifactName": "GeoFluent-${version}.${ext}",
      "warningsAsErrors": false
    },
    "appx": {
      "identityName": "DhruvGupta.GeoFluentGeometryCalculator",
      "publisher": "CN=DhruvGupta",
      "publisherDisplayName": "Dhruv Gupta",
      "applicationId": "GeoFluent",
      "displayName": "GeoFluent Geometry Calculator",
      "artifactName": "GeoFluent-${version}.${ext}"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}
